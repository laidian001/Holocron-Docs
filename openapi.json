{
  "openapi": "3.1.0",
  "info": {
    "title": "Laidian Docs API",
    "version": "1.0.0",
    "description": "示例接口定义，用于演示 Holocron 的 OpenAPI 自动生成能力。"
  },
  "servers": [
    { "url": "https://api.example.com/v1", "description": "生产环境（占位）" }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/health": {
      "get": {
        "summary": "健康检查",
        "operationId": "getHealth",
        "tags": ["系统"],
        "responses": {
          "200": {
            "description": "服务正常",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "object",
                      "properties": { "status": { "type": "string", "example": "ok" } }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/articles": {
      "get": {
        "summary": "获取文章列表",
        "operationId": "listArticles",
        "tags": ["内容"],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } }
        ],
        "responses": {
          "200": { "description": "文章列表" },
          "401": { "description": "未授权" },
          "429": { "description": "触发限流" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" }
    }
  }
}
